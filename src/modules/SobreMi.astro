---
import Subtitle from "@/components/Subtitle.astro";
import {
  hobbiesEnglish,
  hobbiesSpanish,
  abilitiesEnglish,
  abilitiesSpanish,
} from "../utils/aboutMe";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const abilities = lang === "en" ? abilitiesEnglish : abilitiesSpanish;
const hobbies = lang === "en" ? hobbiesEnglish : hobbiesSpanish;
---

<section class="section-module" id="sobre-mi">
  <Subtitle title={t("aboutMe.title")} srcImg="/icons/about.png" />
  <div class="containerDynamic">
    <header
      class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-24 items-center my-10 md:my-20"
    >
      <div class="bg-colorBg2 rounded-2xl p-2 flex gap-4">
        <img
          class="rounded-2xl aspect-square object-cover w-[40%]"
          src="/images/me-photo2.webp"
          alt="me"
        />
        <aside class="flex flex-col gap-1 text-white p-1 w-[60%]">
          <div class="flex">
            <p class="bg-black px-3 py-1 rounded-lg text-xs">
              {t("aboutMe.meAge")}
            </p>
          </div>
          <h3 class="text-xl font-medium">
            <p>Jose Alejandro</p><p>Vasquez Lezama</p>
          </h3>
          <p class="text-Text2 text-sm">{t("hero.mePlace")}</p>
        </aside>
      </div>
      <aside class="text-Text1 text-sm">
        <div>
          <p>
            {t("aboutMe.paragraph1")}
          </p>
          <br />
          <p>
            {t("aboutMe.paragraph2")}
          </p>
        </div>
      </aside>
    </header>
    <section class="my-14">
      <h3 class="text-white font-semibold mt-10 text-lg">
        {t("aboutMe.meSkills")}
      </h3>
      <section
        class="text-sm text-white flex flex-wrap justify-between gap-8 py-5 md:py-10"
      >
        {
          abilities?.map(({ title, description }) => (
            <article class="pl-2">
              <ul class="list-disc marker:text-primary list-outside">
                <li class=" font-semibold text-base text-Text1">{title}</li>
              </ul>
              <p class="text-Text2 max-w-[55ch] ">{description}</p>
            </article>
          ))
        }
      </section>
    </section>
    <footer>
      <h3 class="text-white font-semibold mt-10 text-lg">
        {t("aboutMe.meHabits")}
      </h3>
      <section class="flex flex-wrap justify-center gap-20 text-Text1 py-20">
        {
          hobbies?.map(({ name, imgSrc }) => (
            <article class="flex flex-col justify-center items-center gap-2">
              <div class="h-[71px] w-[71px] bgBlackBlur rounded-full p-4">
                <img
                  class="h-full w-full object-contain"
                  src={`/icons/${imgSrc}`}
                  alt={name}
                />
              </div>
              <p class="text-Text1 font-semibold text-sm">{name}</p>
            </article>
          ))
        }
      </section>
    </footer>
  </div>
</section>
