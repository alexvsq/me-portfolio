---
import Subtitle from "../components/Subtitle.astro";
import { experiences } from "..//utils/experiences";
import { tecnologiesUsed } from "..//utils/tecnologies";

const duplicateTecnologiesUsed = tecnologiesUsed.concat(tecnologiesUsed);
---

<section class="section-module" id="experiencias">
  <Subtitle title="Experiencia" srcImg="/icons/exp.png" />
  <div class="containerDynamic md:py-48">
    <div
      class="relative w-full h-[333px] rounded-tr-full rounded-br-full border-[3px] border-stroke border-l-transparent hidden md:block"
    >
      <div class="absolute w-full -top-[90px] flex">
        {
          experiences.map((experience, index) => {
            if (index < 3)
              return (
                <article class="flex justify-center flex-col gap-2 text-white text-sm w-1/3 pr-4">
                  <div class="flex">
                    <p class=" bgBlackBlur px-3 py-1 text-xs rounded-lg">
                      {experience.year}
                    </p>
                  </div>
                  <p class=" max-w-[35ch]">{experience.title}</p>
                  <div class="bg-primary w-4 h-4 rounded-full" />
                  <p class=" text-Text2 text-sm max-w-[35ch]">
                    {experience.description}
                  </p>
                </article>
              );
          })
        }
      </div>
      <div class="absolute w-full -bottom-[77px] flex">
        {
          experiences.map((experience, index) => {
            if (index > 2)
              return (
                <article class="flex flex-col gap-2 text-white text-sm w-1/3 pr-4">
                  <div class="flex">
                    <p class=" bgBlackBlur px-3 py-1 text-xs rounded-lg">
                      {experience.year}
                    </p>
                  </div>
                  <p class=" max-w-[35ch]">{experience.title}</p>
                  <div class="bg-primary w-4 h-4 rounded-full" />
                  <p class=" text-Text2 text-sm max-w-[35ch]">
                    {experience.description}
                  </p>
                </article>
              );
          })
        }
      </div>
    </div>
    <div class="py-10 md:hidden">
      {
        experiences.map((experience, index) => {
          const isLast = index === experiences.length - 1;
          return (
            <article class="flex justify-center gap-4">
              <div class="flex flex-col items-center">
                <div class="w-4 h-4 bg-primary rounded-full" />
                <div
                  class={`w-[2px] h-full bg-stroke ${isLast ? "hidden" : ""}`}
                />
              </div>
              <aside class="flex flex-col gap-2 text-white text-sm pb-10">
                <div class="flex">
                  <p class="bgBlackBlur px-3 py-1 text-xs rounded-lg">
                    {experience.year}
                  </p>
                </div>
                <p class="max-w-[35ch]">{experience.title}</p>
                <p class="text-Text2 text-sm max-w-[35ch]">
                  {experience.description}
                </p>
              </aside>
            </article>
          );
        })
      }
    </div>
  </div>

  <footer
    class="flex flex-col md:flex-row gap-12 md:max-w-[1040px] md:mx-auto justify-between pt-10 pb-24"
  >
    <div>
      <p class="text-white text-center text-lg md:text-left">
        Tecnologias que eh utilizado
      </p>
    </div>
    <div class="w-full overflow-hidden">
      <aside class="flex gap-6 sliderImagesTrack w-full">
        {
          duplicateTecnologiesUsed?.map(({ name, code }) => (
            <article class="flex flex-col justify-center items-center gap-2 text-white text-sm w-1/3 pr-4">
              <div class=" w-11 h-11 bg-colorBg2 rounded-full p-2">
                <img
                  class="w-full h-full object-contain"
                  src={`/logos/${code}.png`}
                  alt={code}
                />
              </div>
              <p class="  text-xs text-Text1">{name}</p>
            </article>
          ))
        }
      </aside>
    </div>
  </footer>
</section>

<style>
  .sliderImagesTrack {
    -webkit-animation: scroll 20s linear infinite;
    animation: scroll 20s linear infinite;
    width: calc(50px * 22);
  }
  @keyframes scroll {
    0% {
      -webkit-transform: translateX(0);
      transform: translateX(0);
    }
    100% {
      -webkit-transform: translateX(calc(-50px * 11));
      transform: translateX(calc(-50px * 11));
    }
  }
</style>
