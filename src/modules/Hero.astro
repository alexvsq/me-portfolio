---
import LanguagePicker from "@/components/LanguagePicker.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<aside class="absolute top-4 md:top-2 right-4 z-20">
  <LanguagePicker />
</aside>

<header
  id="home"
  class="section-module relative h-screen containerDynamic flex flex-col justify-center md:flex-row-reverse md:justify-between items-center mx-auto"
>
  <div class="absolute bottom-5 w-full flex justify-center">
    <p class="bgBlackBlur py-1 px-5 text-white rounded-full animate-bounce">
      {t("hero.moreContent")} 👇
    </p>
  </div>

  <aside
    class="flex w-full md:w-auto flex-row-reverse justify-between items-end md:items-center md:flex-col gap-4 my-3 md:my-0"
  >
    <div class="bgBlackBlur p-1 md:p-2 rounded-full md:rounded-2xl">
      <img
        class="aspect-square object-cover w-36 md:w-72 rounded-full md:rounded-xl"
        src="/images/me-photo.webp"
        alt="me"
      />
    </div>
    <footer class="flex justify-center items-center">
      <div class="flex gap-1 bg-colorBg2 py-1 px-3 rounded-xl">
        <img class="w-5" src="/icons/place.png" alt="place" />
        <p class="text-white text-sm">{t("hero.mePlace")}</p>
      </div>
    </footer>
  </aside>

  <div class="flex flex-col gap-5">
    <article class="text-3xl md:text-4xl font-bold">
      <p class="text-xl font-medium text-Text2 my-1">
        {t("hero.presentation")}
        <span class="text-white">Alex</span>
      </p>
      <p class="text-white">{t("hero.title1")}</p>
      <p class="text-primary">{t("hero.title2")}</p>
    </article>
    <article class="text-Text1 text-sm max-w-[45ch]">
      <p>
        {t("hero.description1")}
      </p>
      <p>
        {t("hero.description2")}
      </p>
    </article>
    <article>
      <h3 class="text-white text-lg font-semibold my-1">
        {t("hero.skillsTitle")}
      </h3>
      <ul class="text-Text1 text-sm list-disc marker:text-primary list-inside">
        <li>React, Typescript , React Native , NodeJs.</li>
        <li>NextJs, Vite, Expo, Astro.</li>
        <li>MongoDb, MySql , SQLite, Firebase, Supabase.</li>
        <li>CSS, TailwindCss, SASS, Git y Github.</li>
      </ul>
    </article>
  </div>
</header>
