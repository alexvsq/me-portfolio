---
import Subtitle from "../components/Subtitle.astro";
import CardProyecto from "../components/CardProyecto.astro";
import { projectsList } from "../../public/utils/projects";
import type { ProjectType } from "../../src/types/types";
---

<section class="section-module" id="proyectos">
  <Subtitle title="Proyectos" srcImg="/icons/dev.png" />
  <div class="containerDynamic2 flex flex-wrap justify-between items-center">
    {
      projectsList.map((project: ProjectType) => {
        return <CardProyecto {...project} />;
      })
    }
  </div>
</section>
