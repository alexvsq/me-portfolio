---
import type { ProjectType } from "../../src/types/types";
import { getLogo } from "@/utils/getLogos";
const project = Astro.props as ProjectType;
---

<section
  class="bg-colorBg2 border border-stroke p-2 flex flex-col gap-3 md:gap-0 rounded-2xl w-full mx-auto xl:mx-0 md:w-[600px] md:h-[321px] my-5 md:my-12 relative overflow-hidden"
>
  <header
    class="flex flex-col gap-3 md:gap-0 md:flex-row-reverse h-full w-full"
  >
    <aside
      class="bg-colorBg p-1 rounded-xl overflow-hidden h-full w-full md:w-[53%]"
    >
      <div class="rounded-lg overflow-hidden flex w-full h-full">
        {
          Array.isArray(project.media) && project.media.length === 1 ? (
            project.media[0].type === "img" ? (
              <img
                class="w-full mx-auto h-full object-contain content-center"
                src={project.media[0].src}
                alt={project.media[0].type}
              />
            ) : (
              <video
                class="h-full w-full object-cover"
                src={project.media[0].src}
                autoplay
                loop
                muted
                playsinline
              >
                Tu navegador no soporta el elemento video.
              </video>
            )
          ) : (
            Array.isArray(project.media) &&
            project.media.map((item) => (
              <div class=" h-full w-1/2 aspect-[9/16]">
                {item.type === "img" ? (
                  <img
                    class="w-full h-full object-cover"
                    src={item.src}
                    alt={item.type}
                  />
                ) : (
                  <video
                    class="h-full w-full object-cover"
                    src={item.src}
                    autoplay
                    loop
                    muted
                    playsinline
                  >
                    Tu navegador no soporta el elemento video.
                  </video>
                )}
              </div>
            ))
          )
        }
      </div>
    </aside>

    <div class="w-full md:w-[47%] flex flex-col px-2 h-full">
      <header class="flex items-center justify-between">
        <p class="bg-colorBg text-white px-3 py-1 text-[10px] rounded-md">
          {project.about}
        </p>

        <aside class="flex items-center gap-3">
          {
            project.urls?.map((item) => {
              return (
                <a href={item.url} target="_blank" rel="noreferrer">
                  <div class="bg-colorBg rounded-full p-[6px] h-8 w-8">
                    <img
                      class="w-full object-contain"
                      src={`/logos/${item.name}.png`}
                      alt={item.name}
                    />
                  </div>
                </a>
              );
            })
          }
          <div class="h-4 w-4">
            <img class="w-full" src="/icons/open.png" alt="open" />
          </div>
        </aside>
      </header>
      <article class="flex flex-col justify-between h-full font-medium">
        <header class="flex flex-col h-full gap-2 mt-1">
          <h3 class="text-white text-lg font-semibold">{project.name}</h3>

          <p class="text-Text1 text-[13px]">
            {project.description}
          </p>

          <ul
            class="text-Text2 text-[13px] list-disc marker:text-primary list-inside"
          >
            {
              project.abilities?.map((abilities: string) => (
                <li>{abilities}</li>
              ))
            }
          </ul>
        </header>
      </article>
    </div>
  </header>
  <footer
    class="md:absolute bottom-2 pl-1 flex flex-wrap gap-2 text-white text-xs font-normal items-center"
  >
    {
      project.tags?.map((tag: string) => {
        return (
          <div class="bgBlackBlur flex items-center px-2 py-1 rounded-lg gap-2">
            <img
              class="w-4 h-4 object-contain"
              src={`/logos/${tag}.png`}
              alt={tag}
            />
            <p class="">{getLogo(tag)?.name}</p>
          </div>
        );
      })
    }
  </footer>
</section>

<style>
  /* 
   @keyframes show {
    from {
      opacity: 0;
      scale: 10%;
    }
    to {
      opacity: 1;
      scale: 100%;
    }
  }

  .animation-to-show {
    view-timeline-name: --reveal;

    animation-name: show;
    animation-fill-mode: both;

    animation-timeline: --reveal;
    animation-range: entry 25% cover 50%;
  } */
</style>
